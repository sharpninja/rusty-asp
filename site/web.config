<?xml version="1.0" encoding="utf-8"?>
<configuration><system.webServer>
  <defaultDocument><files><clear/><add value="default.asp"/></files></defaultDocument>
  <directoryBrowse enabled="false"/>
  <httpProtocol><customHeaders><clear/>
    <add name="X-Content-Type-Options" value="nosniff"/>
    <add name="Referrer-Policy" value="same-origin"/>
    <add name="Content-Security-Policy" value="default-src 'none'; style-src 'self'; img-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"/>
  </customHeaders></httpProtocol>
  <security><requestFiltering><requestLimits maxAllowedContentLength="16384"/></requestFiltering></security>
</system.webServer></configuration>
